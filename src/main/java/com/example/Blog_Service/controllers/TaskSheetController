package com.example.Blog_Service.controllers;

import com.example.CouponVoucherService.common.ApiResponse;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.boot.ApplicationArguments;
import org.springframework.boot.ApplicationRunner;
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.data.annotation.Id;
import org.springframework.data.domain.Sort;
import org.springframework.data.mongodb.core.MongoTemplate;
import org.springframework.data.mongodb.core.mapping.Document;
import org.springframework.data.mongodb.core.query.Criteria;
import org.springframework.data.mongodb.core.query.Query;
import org.springframework.stereotype.Component;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;

/**
 * Serves the "Internship Tasks" page from MongoDB.
 *
 * Everything lives in this one file:
 *  - TaskSheetController : GET /api/tasks[?group=...]
 *  - TaskDocument        : Mongo document (collection "TaskSheet")
 *  - TaskResponse        : API shape returned to the React app
 *  - TaskSeeder          : inserts the 8 tasks once, only if the collection is empty
 *
 * MongoTemplate is used instead of a repository interface because Spring Data does not
 * pick up nested repository interfaces by default, and this must stay a single file.
 *
 * Response is wrapped in the project's ApiResponse: { success, code, message, data }.
 * To disable seeding, set app.tasks.seed=false.
 */
@RestController
@RequestMapping("/api/tasks")
@RequiredArgsConstructor
@CrossOrigin(originPatterns = "${app.cors.allowed-origin-patterns:*}")
public class TaskSheetController {

    static final String COLLECTION = "TaskSheet";

    private final MongoTemplate mongoTemplate;

    @GetMapping
    public ApiResponse<List<TaskResponse>> getTasks(@RequestParam(required = false) String group) {
        Query query = new Query().with(Sort.by(Sort.Direction.ASC, "displayOrder"));
        if (group != null && !group.isBlank()) {
            query.addCriteria(Criteria.where("group").is(group.trim()));
        }
        List<TaskResponse> tasks = mongoTemplate.find(query, TaskDocument.class).stream()
                .map(TaskResponse::from)
                .toList();
        return ApiResponse.success(tasks);
    }

    /* ----------------------------- Persistence model ----------------------------- */

    @Document(collection = COLLECTION)
    public record TaskDocument(
            @Id String id,
            int displayOrder,
            String title,
            String project,
            String group,
            List<String> problem,
            List<String> did,
            List<String> learned,
            String blogUrl,
            String projectUrl) {
    }

    /* ------------------------------- API response -------------------------------- */

    public record TaskResponse(
            String id,
            int displayOrder,
            String title,
            String project,
            String group,
            List<String> problem,
            List<String> did,
            List<String> learned,
            String blogUrl,
            String projectUrl) {

        static TaskResponse from(TaskDocument d) {
            return new TaskResponse(d.id(), d.displayOrder(), d.title(), d.project(), d.group(),
                    d.problem(), d.did(), d.learned(), d.blogUrl(), d.projectUrl());
        }
    }

    /* ---------------------------------- Seeding ---------------------------------- */

    @Slf4j
    @Component
    @RequiredArgsConstructor
    @ConditionalOnProperty(name = "app.tasks.seed", havingValue = "true", matchIfMissing = true)
    static class TaskSeeder implements ApplicationRunner {

        private final MongoTemplate mongoTemplate;

        @Override
        public void run(ApplicationArguments args) {
            if (mongoTemplate.exists(new Query(), TaskDocument.class)) {
                log.info("Collection '{}' already has data, skipping seed", COLLECTION);
                return;
            }
            List<TaskDocument> seed = seedData();
            mongoTemplate.insertAll(seed);
            log.info("Seeded {} tasks into '{}'", seed.size(), COLLECTION);
        }

        private static TaskDocument task(int order, String title, String project, String group,
                                         List<String> problem, List<String> did, List<String> learned,
                                         String blogUrl, String projectUrl) {
            return new TaskDocument("t" + order, order, title, project, group,
                    problem, did, learned, blogUrl, projectUrl);
        }

